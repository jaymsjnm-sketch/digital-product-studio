# Digital Product Studio configuration. Copy this file to ".env" and fill in what you have.
# Everything is optional - the app works without keys and tells you what data is missing.
# Never share this file or commit it anywhere.

# --- Etsy Open API (live market data + sending drafts to your shop) ---
# Get them free at https://www.etsy.com/developers/your-apps  (Create a New App)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Must match the callback URL you register for your Etsy app:
ETSY_REDIRECT_URI=http://localhost:8000/api/etsy/oauth/callback
ETSY_MAX_QPS=4
ETSY_MAX_DAILY_CALLS=5000

# --- Optional AI services (paid; protected by the spending limits in Settings) ---
# OpenAI image generation for optional AI artwork: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Anthropic (Claude) for AI web research of new niches + free-form revision requests: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional Canva Connect (import designs into Canva) https://www.canva.com/developers/ ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Advanced ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/studio   (default: SQLite in ./data)
# DPS_RENDER_DPI=300
# DPS_MAX_WORKERS=2
